const ecs = @import("github.com/moglang/ecs")

fn require(condition bool, message str) void {
    if (!condition) {
        error(message)
    }
}

// Define the plain, fixed-size data carried by each component.
var positionSchema ecs.Schema = ecs.CreateSchema()
const x ecs.Field = positionSchema.addF32("x")
const y ecs.Field = positionSchema.addF32("y")

var velocitySchema ecs.Schema = ecs.CreateSchema()
const dx ecs.Field = velocitySchema.addF32("dx")
const dy ecs.Field = velocitySchema.addF32("dy")

var world ecs.World = ecs.CreateWorld()
const position ecs.ComponentType =
    world.componentFromSchema("Position", positionSchema)
const velocity ecs.ComponentType =
    world.componentFromSchema("Velocity", velocitySchema)

const entity u64 = world.create()

var positionBytes Array<u8> = positionSchema.buffer()
positionSchema.putF32(positionBytes, x, 10.0)
positionSchema.putF32(positionBytes, y, 20.0)
world.add(entity, position, positionBytes)

var velocityBytes Array<u8> = velocitySchema.buffer()
velocitySchema.putF32(velocityBytes, dx, 2.5)
velocitySchema.putF32(velocityBytes, dy, -1.0)
world.add(entity, velocity, velocityBytes)

// One simulation tick: Position += Velocity for every matching entity.
var moving ecs.Query = world.query([position, velocity])
while (moving.next()) {
    var currentPosition Array<u8> = moving.get(position)
    const currentVelocity Array<u8> = moving.get(velocity)

    positionSchema.putF32(
        currentPosition,
        x,
        positionSchema.getF32(currentPosition, x) +
            velocitySchema.getF32(currentVelocity, dx)
    )
    positionSchema.putF32(
        currentPosition,
        y,
        positionSchema.getF32(currentPosition, y) +
            velocitySchema.getF32(currentVelocity, dy)
    )
    moving.set(position, currentPosition)
}
moving.close()

const updated Array<u8> = world.get(entity, position)
require(positionSchema.getF32(updated, x) == 12.5f32,
        "Position.x was not updated")
require(positionSchema.getF32(updated, y) == 19.0f32,
        "Position.y was not updated")

world.close()
print("position_velocity_ok")
