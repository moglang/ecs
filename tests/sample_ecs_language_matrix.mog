const ecs = @import("github.com/moglang/ecs")

fn require(condition bool, message str) void {
    if (!condition) {
        error(message)
    }
}

var world ecs.World = ecs.CreateWorld()
const a ecs.ComponentType = world.component("A", 1, 1)
const b ecs.ComponentType = world.component("B", 1, 1)
const c ecs.ComponentType = world.component("C", 1, 1)
const absent ecs.ComponentType = world.component("Absent", 1, 1)

const all u64 = world.create()
world.add(all, a, [1])
world.add(all, b, [2])
world.add(all, c, [3])

const pair u64 = world.create()
world.add(pair, a, [4])
world.add(pair, b, [5])

const single u64 = world.create()
world.add(single, a, [6])

var one ecs.Query = world.query([a])
var oneCount i64 = 0
while (one.next()) { oneCount += 1 }
require(oneCount == 3, "one-component query count was wrong")
one.close()

var two ecs.Query = world.query([a, b])
var twoCount i64 = 0
while (two.next()) {
    var bytes Array<u8> = two.get(a)
    bytes[0usize] += 10u8
    two.set(a, bytes)
    twoCount += 1
}
require(twoCount == 2, "two-component query count was wrong")
two.close()
require(world.get(all, a)[0usize] == 11u8 && world.get(pair, a)[0usize] == 14u8,
        "nonstructural query writes were not retained")

var three ecs.Query = world.query([a, b, c])
var threeCount i64 = 0
while (three.next()) {
    require(three.entity() == all, "three-component query returned wrong entity")
    threeCount += 1
}
require(threeCount == 1, "three-component query count was wrong")
three.close()

var empty ecs.Query = world.query([absent])
require(!empty.next(), "empty query unexpectedly matched")
empty.close()

require(world.has(all, c), "component should be present")
world.remove(all, c)
require(!world.has(all, c), "component removal failed")

world.destroy(single)
require(!world.isAlive(single), "destroyed entity remained alive")
const reused u64 = world.create()
require(reused != single, "reused entity retained a stale generation")
require(!world.isAlive(single) && world.isAlive(reused),
        "stale entity generation was accepted")

world.close()
print("ecs_language_matrix_ok")
